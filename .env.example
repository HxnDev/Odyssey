# Copy to .env and fill in from your Supabase project settings (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: AeroDataBox (RapidAPI) key for automatic flight route + time lookup.
# Without it, flights fall back to the keyless adsbdb route database (no times).
EXPO_PUBLIC_AERODATABOX_KEY=
